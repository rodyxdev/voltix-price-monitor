# Copia este archivo a scraper/.env para correr en local. Nunca subas el .env.

# Raíz donde viven las tiendas de /competitors (sin barra final).
VOLTIX_COMPETIDORES_URL=http://localhost:8081

# Solo para `python main.py --guardar` y `python restaurar.py`.
# Project URL (Settings -> API).
SUPABASE_URL=
# Secret key (sb_secret_...) o service_role legacy. Bypassea RLS: solo va aquí
# y en los secrets de GitHub Actions, NUNCA en el dashboard.
SUPABASE_SERVICE_ROLE_KEY=
