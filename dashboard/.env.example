# Copia este archivo a dashboard/.env para correr en local. Nunca subas el .env.

# --- Supabase (solo lectura) --------------------------------------------------
# Project URL (Settings -> API).
SUPABASE_URL=
# Clave PÚBLICA: publishable (sb_publishable_...) o anon legacy.
# El servidor se niega a arrancar si aquí se pone la service role / secret.
SUPABASE_ANON_KEY=

# --- Botón "Ejecutar monitoreo ahora" (opcional) ------------------------------
# Fine-grained PAT con acceso SOLO a rodyxdev/voltix-price-monitor y el permiso
# "Actions: Read and write". Sin él, el botón aparece deshabilitado.
VOLTIX_GITHUB_TOKEN=
VOLTIX_GITHUB_REPO=rodyxdev/voltix-price-monitor
VOLTIX_GITHUB_WORKFLOW=monitoreo.yml
VOLTIX_GITHUB_REF=main
# Minutos mínimos entre dos ejecuciones manuales (1 a 1440).
VOLTIX_COOLDOWN_MINUTOS=10

# --- Operación ----------------------------------------------------------------
PORT=3000
