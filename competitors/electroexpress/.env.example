# Copia a .env para correr en local. Nunca subas el .env.
# Project URL (Settings -> API).
SUPABASE_URL=
# Clave PÚBLICA (sb_publishable_... o anon legacy). La tienda solo lee: si
# recibe la service role / secret se niega a arrancar.
SUPABASE_ANON_KEY=
# Puerto local (por defecto 8081 GigaBazar, 8082 ElectroExpress).
PORT=
